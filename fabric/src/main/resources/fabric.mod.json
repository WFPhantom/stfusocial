{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "issues": "${issue_tracker}"
    },
    "license": "${license}",
    "icon": "${logo}",
    "environment": "client",
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
  